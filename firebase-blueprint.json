{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "A user-owned to-do item with scheduling, collaboration, and media metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the task"
        },
        "userId": {
          "type": "string",
          "description": "The UID of the task owner"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Title of the task"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Detailed notes or transcript of the task"
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the task is completed"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "urgent"],
          "description": "Task urgency priority"
        },
        "category": {
          "type": "string",
          "maxLength": 50,
          "description": "Category or tag for grouping"
        },
        "dueDate": {
          "type": "string",
          "maxLength": 50,
          "description": "ISO date string or human readable deadline"
        },
        "estimatedMinutes": {
          "type": "number",
          "description": "Estimated duration in minutes for smart scheduling"
        },
        "collaboratorEmails": {
          "type": "string",
          "maxLength": 500,
          "description": "Comma-separated collaborator emails"
        },
        "voiceMemoUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional audio/media data URL or reference"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the task was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the task was last updated"
        }
      },
      "required": ["userId", "title", "completed", "priority", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User preferences, personalized widgets, and biometric auth flags",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "maxLength": 100,
          "description": "User email address"
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light", "system"],
          "description": "Selected theme mode"
        },
        "language": {
          "type": "string",
          "maxLength": 10,
          "description": "Preferred UI language code"
        },
        "biometricsEnabled": {
          "type": "boolean",
          "description": "Whether biometric / screen lock is active"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when profile was updated"
        }
      },
      "required": ["userId", "updatedAt"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Collection of tasks isolated to their creator or shared collaborators"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile and dashboard settings"
    }
  }
}
