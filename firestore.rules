rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['userId', 'title', 'completed', 'priority', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'description', 'completed', 'priority', 'category', 'dueDate', 'estimatedMinutes', 'collaboratorEmails', 'voiceMemoUrl', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && data.completed is bool
        && data.priority in ['low', 'medium', 'high', 'urgent']
        && (!('category' in data) || (data.category is string && data.category.size() <= 50))
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 50))
        && (!('estimatedMinutes' in data) || (data.estimatedMinutes is number && data.estimatedMinutes >= 0 && data.estimatedMinutes <= 1440))
        && (!('collaboratorEmails' in data) || (data.collaboratorEmails is string && data.collaboratorEmails.size() <= 500))
        && (!('voiceMemoUrl' in data) || (data.voiceMemoUrl is string && data.voiceMemoUrl.size() <= 1000))
        && (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && ((data.createdAt is string && data.createdAt.size() <= 50) || data.createdAt is timestamp)
        && ((data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'email', 'theme', 'language', 'biometricsEnabled', 'updatedAt'])
        && data.userId == request.auth.uid
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('theme' in data) || (data.theme in ['dark', 'light', 'system']))
        && (!('language' in data) || (data.language is string && data.language.size() <= 10))
        && (!('biometricsEnabled' in data) || data.biometricsEnabled is bool)
        && ((data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp);
    }

    // Connection testing endpoint for boot verification
    match /test/{testId} {
      allow get: if true;
    }

    // Isolated Tasks Collection
    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(taskId) && isValidTask(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(taskId) && isValidTask(incoming())
                    && existing().userId == request.auth.uid
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(taskId) && existing().userId == request.auth.uid;
    }

    // Private User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming())
                    && existing().userId == request.auth.uid
                    && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
